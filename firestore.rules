rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isDoctor() {
      return request.auth != null && request.auth.token.get('doctor', false) == true;
    }

    function hasValidPayment(data) {
      let status = data.get('paymentStatus', '');
      let details = data.get('paymentDetails', {});
      let fee = details.get('originalFee', 0);
      let amount = details.get('finalAmount', -1);
      let discount = details.get('discount', 0);
      let discountType = details.get('discountType', '');
      let reason = details.get('reason', '');
      return status in ['Paid', 'Discount', 'Exempt']
        && details is map
        && details.get('confirmedBy', '') == request.auth.uid
        && details.get('confirmedAt', null) == request.time
        && fee is number
        && fee > 0
        && amount is number
        && amount >= 0
        && amount <= fee
        && discount is number
        && ((status == 'Paid' && amount == fee && discount == 0)
          || (status == 'Exempt' && amount == 0 && discount == 0
            && reason is string && reason != '')
          || (status == 'Discount' && amount < fee && discount > 0
            && reason is string && reason != ''
            && ((discountType == 'percent' && discount <= 100)
              || (discountType == 'amount' && discount <= fee))));
    }

    function paymentFieldsUnchanged() {
      return request.resource.data.get('paymentStatus', null) == resource.data.get('paymentStatus', null)
        && request.resource.data.get('paymentDetails', null) == resource.data.get('paymentDetails', null)
        && request.resource.data.get('paymentId', null) == resource.data.get('paymentId', null);
    }

    function paymentRecordMatchesAppointment(appointmentId, data) {
      let payment = getAfter(/databases/$(database)/documents/payments/$(appointmentId));
      return payment.data.get('paymentId', '') == appointmentId
        && payment.data.get('appointmentId', '') == appointmentId
        && payment.data.get('paymentStatus', '') == data.get('paymentStatus', '')
        && payment.data.get('paymentDetails', {}) == data.get('paymentDetails', {});
    }

    function appointmentMatchesPayment(paymentId, data) {
      let appointment = getAfter(/databases/$(database)/documents/appointments/$(paymentId));
      return appointment.data.get('paymentId', '') == paymentId
        && appointment.data.get('paymentStatus', '') == data.get('paymentStatus', '')
        && appointment.data.get('paymentDetails', {}) == data.get('paymentDetails', {});
    }

    function validPinRecord(data) {
      return data.keys().hasOnly(['salt', 'hash', 'iterations', 'updatedAt'])
        && data.keys().hasAll(['salt', 'hash', 'iterations', 'updatedAt'])
        && data.get('salt', '') is string
        && data.get('salt', '').matches('^[a-fA-F0-9]{48}$')
        && data.get('hash', '') is string
        && data.get('hash', '').matches('^[a-fA-F0-9]{64}$')
        && data.get('iterations', 0) == 310000
        && data.get('updatedAt', null) is timestamp;
    }

    match /appointments/{appointmentId} {
      allow create: if !('paymentStatus' in request.resource.data)
        && !('paymentDetails' in request.resource.data);
      allow read, delete: if isDoctor();
      allow update: if isDoctor()
        && (paymentFieldsUnchanged()
          || (resource.data.get('paymentId', '') == ''
            && (!(resource.data.get('paymentStatus', '') in ['Paid', 'Discount', 'Exempt'])
              || request.resource.data.get('paymentStatus', '') == resource.data.get('paymentStatus', ''))
            && !exists(/databases/$(database)/documents/payments/$(appointmentId))
            && request.resource.data.get('paymentId', '') == appointmentId
            && hasValidPayment(request.resource.data)
            && paymentRecordMatchesAppointment(appointmentId, request.resource.data)));
    }

    match /payments/{paymentId} {
      allow read: if isDoctor();
      allow create: if isDoctor()
        && hasValidPayment(request.resource.data)
        && request.resource.data.get('paymentId', '') == paymentId
        && request.resource.data.get('createdAt', null) == request.time
        && ((request.resource.data.get('appointmentId', '') == ''
            && request.resource.data.get('patientName', '') is string
            && request.resource.data.get('patientName', '') != '')
          || (request.resource.data.get('appointmentId', '') == paymentId
            && appointmentMatchesPayment(paymentId, request.resource.data)));
      allow update, delete: if false;
    }

    match /patientRecords/{recordId} {
      allow read, write: if isDoctor();
    }

    match /esignPins/{uid} {
      allow read: if isDoctor() && request.auth.uid == uid;
      allow create, update: if isDoctor()
        && request.auth.uid == uid
        && validPinRecord(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
