# ─────────────────────────────────────────────────────────────────────────────
# Neuro Mind Bloom — environment variables
# Copy to .env.local for local development. On Vercel add them under
# Project → Settings → Environment Variables (separately for Preview and Production).
# NEVER commit real values. Use a SEPARATE Firebase project + Razorpay TEST keys
# for development so testing never touches live patient data or real money.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase web app config (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only). Service account JSON, base64-encoded:
#   base64 -w0 service-account.json      (macOS: base64 -i service-account.json)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Razorpay (server only secrets). Use rzp_test_... keys until go-live approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Show the "Pay now" button on the booking page ("true" / "false")
NEXT_PUBLIC_RAZORPAY_ENABLED=false

# UPI for the "Payment QR" sent to patients after an appointment is confirmed
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Neuro Mind Bloom

# Optional: only if the doctor has NEVER set an e-sign PIN via "Recover / Set PIN".
# Remove after the PIN has been set.
ESIGN_LEGACY_PIN_SALT=
ESIGN_LEGACY_PIN_HASH=

# ── E-prescription secure links (server only) ────────────────────────────────
# Random string, 32+ characters:  openssl rand -base64 48
RX_LINK_SECRET=
# Optional: base URL used in links (defaults to https://www.neuromindbloom.com).
# For a Vercel PREVIEW deployment set it to that preview URL.
PUBLIC_BASE_URL=

# ── Automatic WhatsApp (Meta WhatsApp Cloud API) — see docs/NOTIFICATIONS.md ─
# Leave empty to keep using the manual "Open WhatsApp" buttons only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# ── Automatic email (Resend, https://resend.com) ─────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Neuro Mind Bloom <care@neuromindbloom.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=drkuldeepbudania23@gmail.com

# Where the doctor receives "new booking" alerts
DOCTOR_ALERT_WHATSAPP=
DOCTOR_ALERT_EMAIL=

# Vercel Cron secret for daily follow-up reminders (32+ random characters)
CRON_SECRET=

# ── Video consultation ───────────────────────────────────────────────────────
# Any combination can be set; the doctor picks per appointment (Google Meet / Daily / Zoom / JaaS / Jitsi).
# Google Meet and free meet.jit.si need no keys and are always available. RX_LINK_SECRET (above) signs patient links.
# Default when the doctor hasn't chosen (Google Meet if empty): meet | daily | zoom | jaas | jitsi
VIDEO_DEFAULT_PROVIDER=

# Daily.co (website video, free 10,000 participant-minutes/month): dashboard.daily.co → Developers → API key
DAILY_API_KEY=

# Zoom (opens in Zoom app): marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
# Scopes: meeting:write:meeting:admin (create), meeting:read:meeting:admin (read)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Jitsi as a Service (8x8 JaaS, free 25 monthly users): jaas.8x8.vc
JAAS_APP_ID=
JAAS_API_KEY_ID=
# The private key downloaded when creating the API key (PEM, or base64 of the PEM)
JAAS_PRIVATE_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
# 2FA: key that encrypts authenticator secrets (32+ random chars). Falls back to RX_LINK_SECRET.
MFA_ENCRYPTION_KEY=
# How long one 2FA verification lasts (hours, 1–24)
MFA_SESSION_HOURS=12
# Firebase App Check with reCAPTCHA v3 (optional): site key from Google reCAPTCHA admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Weekly encrypted backup (Sunday 2 AM IST). KEEP THIS KEY SAFE — without it backups cannot be opened.
BACKUP_ENCRYPTION_KEY=
# Where to put it: a Cloud Storage bucket (Blaze plan) …
BACKUP_STORAGE_BUCKET=
# … or emailed (needs Resend above). Defaults to DOCTOR_ALERT_EMAIL.
BACKUP_EMAIL=
